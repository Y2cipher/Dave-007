class DataCleaner:
    def __init__(self):
        self.data = []

    def receive_data(self):
        count = int(input("How many values do you want to enter? "))

        for i in range(count):
            value = input("Enter a value (or leave empty): ")

            if value == "":
                self.data.append(None)
            else:
                self.data.append(int(value))

    def clean_data(self):
        clean_values = []

        for v in self.data:
            if v is None:
                continue

            if v < 0:
                continue

            clean_values.append(v)

        self.data = clean_values


cleaner = DataCleaner()
cleaner.receive_data()
cleaner.clean_data()

print("Clean data:", cleaner.data)
